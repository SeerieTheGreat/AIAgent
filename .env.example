# Agent-side settings. Copy to .env. Keys are testnet only.
ANTHROPIC_API_KEY=
AGENT_PRIVATE_KEY=
SHOUHU_CHAIN=anvil            # anvil | sepolia | base-sepolia
SHOUHU_MODEL=claude-opus-5-5  # claude-sonnet-5-5 for faster demo turns
SHOUHU_EFFORT=medium
# Optional dedicated endpoints; public ones are used when empty
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# The owner key lives in .owner.env (OWNER_PRIVATE_KEY=...) and is read only by shouhu-owner and shouhu-deploy.
